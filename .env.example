# Copy to .env and fill in your key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Thinking mode is ON by default for this model; the agent disables it. Use 'enabled' to turn it on.
DEEPSEEK_THINKING=disabled

# Mailpit endpoints (defaults match docker-compose.yml)
INBOX_API=http://localhost:8025
INBOX_SMTP_HOST=localhost
INBOX_SMTP_PORT=1025
EGRESS_API=http://localhost:8026
EGRESS_SMTP_HOST=localhost
EGRESS_SMTP_PORT=1026
